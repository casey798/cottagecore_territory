  /**
   * Stone Pairs (Memory Matching) — Pure logic, no React dependencies.
   */

  // ---------------------------------------------------------------------------
  // Types
  // ---------------------------------------------------------------------------

  // ---------------------------------------------------------------------------
  // Icon sets — one set is picked randomly per game session
  // ---------------------------------------------------------------------------

  var ICON_SETS = exports.ICON_SETS = [['🍄', '🌿', '🌸', '🍂', '🐚', '🌾', '🍁', '🦋'],
  // NATURE
  ['🦊', '🦔', '🐇', '🦉', '🐝', '🐸', '🦌', '🐦'],
  // CREATURES
  ['🍯', '🧁', '🫐', '🍵', '🥐', '🍎', '🧇', '🫙'],
  // FOOD & DRINK
  ['🌧️', '☀️', '🌙', '❄️', '🌈', '⚡', '🌫️', '🍃'],
  // WEATHER
  ['🌻', '🌱', '🪴', '🌺', '🪨', '🌳', '🪵', '🌰'],
  // GARDEN
  ['🕯️', '📖', '🧶', '🧺', '🛖', '🧣', '🪔', '🎋'] // COZY
  ];

  // ---------------------------------------------------------------------------
  // Grid config (fixed 4x4 = 8 pairs)
  // ---------------------------------------------------------------------------

  var GRID_ROWS = 4;
  var GRID_COLS = 4;
  var TOTAL_PAIRS = 8;

  // ---------------------------------------------------------------------------
  // Fisher–Yates shuffle (in-place)
  // ---------------------------------------------------------------------------

  function shuffle(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = arr[i];
      arr[i] = arr[j];
      arr[j] = tmp;
    }
    return arr;
  }

  // ---------------------------------------------------------------------------
  // Public API
  // ---------------------------------------------------------------------------

  /**
   * Generate a puzzle: 4×4 grid = 16 cards = 8 pairs.
   * Picks one icon set randomly, then creates paired cards and shuffles.
   */
  function generatePuzzle() {
    // Pick a random icon set
    var iconSet = ICON_SETS[Math.floor(Math.random() * ICON_SETS.length)];

    // Create two cards per icon (8 icons × 2 = 16 cards).
    var cards = [];
    var nextId = 0;
    for (var i = 0; i < TOTAL_PAIRS; i++) {
      cards.push({
        id: nextId++,
        iconIndex: i,
        iconLabel: iconSet[i]
      });
      cards.push({
        id: nextId++,
        iconIndex: i,
        iconLabel: iconSet[i]
      });
    }
    shuffle(cards);

    // Re-assign sequential ids after shuffle so id === position-in-array.
    cards.forEach(function (card, i) {
      card.id = i;
    });
    return {
      cards: cards,
      rows: GRID_ROWS,
      cols: GRID_COLS,
      totalPairs: TOTAL_PAIRS
    };
  }

  /**
   * Returns true when both cards share the same icon (but are different cards).
   */
  function checkMatch(card1, card2) {
    return card1.id !== card2.id && card1.iconIndex === card2.iconIndex;
  }

  /**
   * Validate whether the player has solved the puzzle.
   */
  function validateSolution(puzzle, submission) {
    return {
      solved: submission.matchedPairs === puzzle.totalPairs
    };
  }
