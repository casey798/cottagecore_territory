  exports.getTimeUntilExpiry = getTimeUntilExpiry;
  /**
   * Parse an ISO expiry timestamp and return hours + minutes remaining.
   */
  function getTimeUntilExpiry(expiresAt) {
    var expiryMs = new Date(expiresAt).getTime();
    var nowMs = Date.now();
    var diffMs = expiryMs - nowMs;
    if (diffMs <= 0) {
      return {
        hours: 0,
        minutes: 0,
        expired: true
      };
    }
    var totalMinutes = Math.floor(diffMs / 60000);
    return {
      hours: Math.floor(totalMinutes / 60),
      minutes: totalMinutes % 60,
      expired: false
    };
  }
